# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your SSO credentials
# DO NOT COMMIT secrets.toml TO GIT

[auth]
# Local redirect URI for development:
# redirect_uri = "http://localhost:8501/oauth2callback"

# Production redirect URI for Streamlit Cloud:
redirect_uri = "https://placement-training-app-29gheabcvw6gk9c5g3xl6i.streamlit.app/oauth2callback"

# Generate a strong 32+ character random string (e.g. openssl rand -hex 32)
cookie_secret = "CHANGE_THIS_TO_A_SECURE_32_CHAR_RANDOM_SECRET_KEY"

# ------------------------------------------------------------------------------
# 1. MICROSOFT ENTRA ID SSO
# ------------------------------------------------------------------------------
[auth.microsoft]
# From Azure Portal -> Microsoft Entra ID -> App Registrations -> Application (client) ID
client_id = "YOUR_MICROSOFT_CLIENT_ID"

# From Azure Portal -> Certificates & Secrets -> New client secret -> Value
client_secret = "YOUR_MICROSOFT_CLIENT_SECRET"

# OpenID Connect Metadata URL for your Microsoft Entra Tenant:
# Replace YOUR_TENANT_ID with your Directory (tenant) ID or 'common' / 'organizations'
server_metadata_url = "https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0/.well-known/openid-configuration"

# ------------------------------------------------------------------------------
# 2. GOOGLE WORKSPACE / GOOGLE OAUTH SSO
# ------------------------------------------------------------------------------
[auth.google]
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# From Google Cloud Console -> OAuth 2.0 Client Secret
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

# Google OpenID Connect Discovery URL
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

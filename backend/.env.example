# =================================================================
# PLACEMENT TRAINING PORTAL - ENVIRONMENT CONFIGURATION
# =================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Connection (PostgreSQL in production, SQLite async supported for local dev)
DATABASE_URL=sqlite+aiosqlite:///./placement_portal.db

# JWT & Session Security
SECRET_KEY=placement-training-portal-super-secure-session-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Microsoft Entra ID / Azure AD Authentication
# Register an app in Microsoft Entra admin center to populate these
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=replace_with_actual_entra_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback

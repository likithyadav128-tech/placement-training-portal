datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  FACULTY
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

enum AssessmentType {
  CODING
  APTITUDE
  MOCK
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  CODING
  MCQ
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  microsoftId   String?         @unique
  passwordHash  String?
  role          UserRole        @default(STUDENT)
  status        UserStatus      @default(ACTIVE)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastLogin     DateTime?

  studentProfile Student?
  facultyProfile Faculty?
  userPermissions UserPermission[]
  auditLogs      AuditLog[]
  attempts       TestAttempt[]
  notifications  Notification[]
  createdAssessments Assessment[] @relation("CreatedBy")

  @@index([email])
  @@index([role, status])
}

model Department {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  students    Student[]
  faculty     Faculty[]
}

model Student {
  id                String      @id @default(cuid())
  userId            String      @unique
  studentId         String      @unique
  departmentId      String
  year              Int         @default(4)
  section           String      @default("A")
  cgpa              Float       @default(8.5)
  overallScore      Float       @default(75.0)
  codingScore       Float       @default(80.0)
  aptitudeScore     Float       @default(74.0)
  mockScore         Float       @default(76.0)
  readinessStatus   String      @default("PLACEMENT_READY")
  facultyAdvisorId  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department  @relation(fields: [departmentId], references: [id])
  facultyAdvisor    Faculty?    @relation(fields: [facultyAdvisorId], references: [id])
  roadmaps          Roadmap[]
  recommendations   Recommendation[]
  performanceRecords PerformanceRecord[]
  facultyNotes      FacultyNote[]

  @@index([departmentId, year])
  @@index([facultyAdvisorId])
}

model Faculty {
  id            String      @id @default(cuid())
  userId        String      @unique
  employeeId    String      @unique
  departmentId  String
  designation   String      @default("Placement Coordinator")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department  @relation(fields: [departmentId], references: [id])
  advisedStudents Student[]
  notes         FacultyNote[]

  @@index([departmentId])
}

model Permission {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?
  category    String
  createdAt   DateTime          @default(now())

  userPermissions UserPermission[]
}

model UserPermission {
  id           String      @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean     @default(true)
  grantedById  String?
  createdAt    DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Assessment {
  id            String            @id @default(cuid())
  title         String
  description   String?
  type          AssessmentType    @default(CODING)
  category      String
  difficulty    String            @default("Medium")
  duration      Int               @default(45)
  totalMarks    Float             @default(100.0)
  passingScore  Float             @default(60.0)
  status        AssessmentStatus  @default(PUBLISHED)
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdBy     User              @relation("CreatedBy", fields: [createdById], references: [id])
  questions     AssessmentQuestion[]
  attempts      TestAttempt[]

  @@index([type, status])
}

model Question {
  id            String          @id @default(cuid())
  title         String?
  question      String
  type          QuestionType    @default(CODING)
  category      String
  difficulty    String          @default("Medium")
  marks         Float           @default(10.0)
  answer        String?
  explanation   String?
  codeTemplate  String?
  testCases     Json?
  options       Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  assessments   AssessmentQuestion[]
  answers       AttemptAnswer[]
}

model AssessmentQuestion {
  id            String      @id @default(cuid())
  assessmentId  String
  questionId    String
  orderIndex    Int         @default(1)

  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model TestAttempt {
  id            String          @id @default(cuid())
  assessmentId  String
  userId        String
  startedAt     DateTime        @default(now())
  submittedAt   DateTime?
  score         Float           @default(0.0)
  percentage    Float           @default(0.0)
  timeTakenSec  Int             @default(0)
  status        String          @default("COMPLETED")
  createdAt     DateTime        @default(now())

  assessment    Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       AttemptAnswer[]

  @@index([userId, assessmentId])
}

model AttemptAnswer {
  id            String       @id @default(cuid())
  attemptId     String
  questionId    String
  submittedCode String?
  selectedOption String?
  isCorrect     Boolean      @default(false)
  marksAwarded  Float        @default(0.0)
  testResults   Json?

  attempt       TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Roadmap {
  id          String        @id @default(cuid())
  studentId   String
  title       String
  description String?
  progress    Float         @default(0.0)
  status      String        @default("IN_PROGRESS")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  steps       RoadmapStep[]
}

model RoadmapStep {
  id          String    @id @default(cuid())
  roadmapId   String
  orderIndex  Int
  title       String
  category    String
  percentage  Float     @default(0.0)
  status      String    @default("PENDING")
  dueDate     DateTime?

  roadmap     Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, orderIndex])
}

model PerformanceRecord {
  id            String    @id @default(cuid())
  studentId     String
  date          DateTime  @default(now())
  overallScore  Float
  codingScore   Float
  aptitudeScore Float
  mockScore     Float

  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
}

model Recommendation {
  id          String    @id @default(cuid())
  studentId   String
  title       String
  type        String
  description String
  priority    String    @default("HIGH")
  category    String
  createdAt   DateTime  @default(now())

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model FacultyNote {
  id          String    @id @default(cuid())
  facultyId   String
  studentId   String
  note        String
  createdAt   DateTime  @default(now())

  faculty     Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  userEmail   String
  userRole    String
  action      String
  target      String
  details     String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model SystemSetting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
